# Copy this file to .env.local for local development
# Copy to .env.production for production builds

# Backend API base URL
# Local dev:     http://localhost:8001
# Production EC2: use relative path (Vercel rewrites /api/* to EC2)
# AWS EC2:       http://your-ec2-ip:8001
VITE_API_URL=http://localhost:8001

# App name shown in meta tags (optional)
VITE_APP_NAME=Arkaserve Tools

# Maximum file size in MB (informational, enforced by backend)
VITE_MAX_FILE_MB=50
